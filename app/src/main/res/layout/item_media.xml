<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_dark"
        android:gravity="center"
        android:text="♪"
        android:textColor="@color/text_sub"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMediaTitle"
            style="@style/KmTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên bài" />

        <TextView
            android:id="@+id/tvMediaSub"
            style="@style/KmTextSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ca sĩ" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMediaDuration"
        style="@style/KmTextSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00" />

    <TextView
        android:id="@+id/tvMakeProject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Tạo dự án"
        android:textColor="@color/accent_pink"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
