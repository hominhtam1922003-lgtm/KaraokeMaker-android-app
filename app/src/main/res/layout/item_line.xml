<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_btn_dark"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/text_main"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dòng lời"
            android:textColor="@color/text_main"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_gray"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Giọng: tự động"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvUnmatched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⚠ Chưa khớp"
                android:textColor="@color/warn_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLineTime"
            style="@style/KmTextSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0:00 – 0:00" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_btn_dark"
                android:text="−0,1"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_dark"
                android:text="+0,1"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_dark"
                android:text="✎"
                android:textColor="@color/text_main"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
