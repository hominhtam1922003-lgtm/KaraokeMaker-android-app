<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_dark"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:paddingStart="0dp"
            android:paddingTop="6dp"
            android:paddingEnd="0dp"
            android:paddingBottom="6dp"
            android:text="←"
            android:textColor="@color/text_main"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/KmTextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xuất video"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvExportSub"
                style="@style/KmTextSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveTemplate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_dark"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Lưu cấu hình làm mẫu"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.example.karaokemaker.ui.KaraokePreviewView
                android:id="@+id/previewExport"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

            <!-- Thẻ thông tin như khung thiết kế -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thời lượng" />

                    <TextView
                        android:id="@+id/tvInfoDuration"
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nguồn nhạc" />

                    <TextView
                        android:id="@+id/tvInfoBeat"
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beat đã tách" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dòng lời" />

                    <TextView
                        android:id="@+id/tvInfoLines"
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dòng" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bộ mã hoá" />

                    <TextView
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Phần cứng (MediaCodec)"
                        android:textColor="@color/ok_green" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tên file" />

                    <TextView
                        android:id="@+id/tvFileName"
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="karaoke.mp4" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lưu vào" />

                    <TextView
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Movies/KaraokeMaker" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/KmTextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ĐỊNH DẠNG ĐĂNG TẢI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/preset169"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_selected"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube · 16:9"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreset169Sub"
                        style="@style/KmTextSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1280 × 720 · ngang" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/preset916"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shorts / TikTok · 9:16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreset916Sub"
                        style="@style/KmTextSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720 × 1280 · dọc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/preset11"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facebook · 1:1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreset11Sub"
                        style="@style/KmTextSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720 × 720 · vuông" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/presetQuality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvQualityTitle"
                        style="@style/KmTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chất lượng · 720p"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/KmTextSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chạm để đổi 720p / 1080p" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRenderNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_gradient_btn"
                android:minHeight="56dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="+ Thêm bài này vào hàng đợi xuất"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <TextView
        style="@style/KmTextTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hàng đợi xuất"
        android:textSize="16sp" />

    <TextView
        style="@style/KmTextSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xuất lần lượt · xong bài nào mở xem ngay bài đó" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueue"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
