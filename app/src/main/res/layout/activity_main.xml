<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Đầu trang: logo gradient + tên app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_grad"
            android:gravity="center"
            android:text="♪"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/KmTextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karaoke Maker"
                android:textSize="20sp" />

            <TextView
                style="@style/KmTextSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Làm video karaoke từ link YouTube hoặc file trong máy" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gradient_btn"
            android:text="+ Tạo video karaoke"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⬇ Nhập nhạc"
            android:textColor="@color/text_main" />
    </LinearLayout>

    <!-- Thẻ model AI -->
    <LinearLayout
        android:id="@+id/cardModels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/KmTextSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODEL AI (tải lần đầu, dùng mãi về sau)" />

        <TextView
            android:id="@+id/tvWhisperModel"
            style="@style/KmTextSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chép lời (Whisper small · ~376 MB): chưa tải" />

        <TextView
            android:id="@+id/tvMdxModel"
            style="@style/KmTextSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tách beat AI (MDX · ~67 MB): chưa tải" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDlWhisper"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_dark"
                android:text="Tải model chép lời"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDlMdx"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_dark"
                android:text="Tải model tách beat"
                android:textColor="@color/text_main"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Banner job đang chạy -->
    <LinearLayout
        android:id="@+id/cardJob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJobText"
                style="@style/KmTextBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đang xử lý..." />

            <Button
                android:id="@+id/btnJobCancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_dark"
                android:text="Huỷ"
                android:textColor="@color/error_red"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbJob"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_gradient" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/KmTextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dự án của tôi"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvProjectCount"
            style="@style/KmTextSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyProjects"
        style="@style/KmTextSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Chưa có dự án nào. Bấm “+ Tạo video karaoke” để bắt đầu: dán link YouTube hoặc chọn file nhạc trong máy."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/KmTextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bài hát trong máy"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnScanMedia"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_dark"
            android:text="Quét nhạc"
            android:textColor="@color/accent_pink"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedia"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="6dp" />
</LinearLayout>
